{
  "id": null,
  "uid": "node-exporter-basic",
  "title": "Node Exporter Metrics",
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "panels": [
    {
      "type": "graph",
      "title": "CPU Load (1m)",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 10},
      "targets": [
        {
          "expr": "node_load1",
          "legendFormat": "1m load",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Memory Usage",
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "memory %",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Disk IO Rate",
      "gridPos": {"x": 12, "y": 10, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(node_disk_io_time_seconds_total[5m])",
          "legendFormat": "disk io",
          "refId": "A"
        }
      ]
    }
  ]
}
